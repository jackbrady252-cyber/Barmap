+/* Hidden spots saved by this browser */
+const HIDDEN_SPOTS_KEY = 'barmap.hiddenSpots.v1';
+function equipmentFromInput(value) {
+  return String(value || '')
+    .split(',')
+    .map(x => x.trim())
+    .filter(Boolean)
+    .slice(0, 12);
+}
+function readSavedHiddenSpots() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(HIDDEN_SPOTS_KEY) || '[]');
+    return Array.isArray(saved) ? saved.filter(s => Number.isFinite(s.lat) && Number.isFinite(s.lng)) : [];
+  } catch (err) {
+    console.warn('Could not load hidden spots', err);
+    return [];
+  }
+}
+function writeSavedHiddenSpots() {
+  const hidden = parks
+    .filter(p => p.hiddenSpot)
+    .map(({ id, name, area, lat, lng, equipment, hiddenLevel, bestTime, notes, createdAt }) => ({
+      id, name, area, lat, lng, equipment, hiddenLevel, bestTime, notes, createdAt
+    }));
+  try {
+    localStorage.setItem(HIDDEN_SPOTS_KEY, JSON.stringify(hidden));
+  } catch (err) {
+    console.warn('Could not save hidden spots', err);
+  }
+}
+function makeHiddenSpot(raw) {
+  return {
+    id: raw.id || Date.now(),
+    name: raw.name,
+    area: raw.area,
+    lat: Number(raw.lat),
+    lng: Number(raw.lng),
+    source: 'hidden',
+    verified: false,
+    hiddenSpot: true,
+    hiddenLevel: raw.hiddenLevel || 'Tucked away',
+    bestTime: raw.bestTime || '',
+    notes: raw.notes || '',
+    createdAt: raw.createdAt || new Date().toISOString(),
+    equipment: Array.isArray(raw.equipment) ? raw.equipment : equipmentFromInput(raw.equipment)
+  };
+}
+readSavedHiddenSpots().forEach(saved => parks.push(makeHiddenSpot(saved)));
+
